{
	"name": "pine-island-food-pantry",
	"version": "1.1",
	"private": true,
	"engines": {
		"node": "26.x"
	},
	"scripts": {
		"docs:generate": "node scripts/generate-cms-help.mjs",
		"docs:check": "node scripts/generate-cms-help.mjs --check",
		"test:docs": "node --test tests/cms-help.test.mjs",
		"test:presentation": "node --test tests/presentation.test.mjs && playwright test --config playwright.presentation.config.ts",
		"prebuild": "npm run docs:generate",
		"predev": "npm run docs:generate",
		"build": "next build",
		"dev": "next",
		"format": "npx biome format --write .",
		"lint": "npx biome check",
		"lint:fix": "npx biome check --write",
		"start": "next start",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"type-check": "tsc --noEmit"
	},
	"dependencies": {
		"@portabletext/react": "^8.0.1",
		"@sanity/demo": "2.0.0",
		"@sanity/icons": "^5.3.0",
		"@sanity/image-url": "2.1.1",
		"@sanity/preview-url-secret": "^4.1.5",
		"@sanity/react-loader": "^2.3.0",
		"@sanity/ui": "^4.4.10",
		"@sanity/vision": "^6.22.0",
		"@sanity/visual-editing": "^6.2.0",
		"@tailwindcss/typography": "0.5.20",
		"@web3forms/react": "^1.1.3",
		"classnames": "2.5.1",
		"date-fns": "4.4.0",
		"next": "^16.4.5",
		"next-sanity": "^13.4.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-hook-form": "^7.91.0",
		"react-markdown": "^10.1.0",
		"sanity": "^6.22.0",
		"sanity-plugin-asset-source-unsplash": "^7.0.30",
		"server-only": "0.0.1",
		"styled-components": "^6.6.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.6",
		"@playwright/test": "^1.65.0",
		"@sanity/comlink": "^4.0.3",
		"@sanity/presentation-comlink": "^2.2.3",
		"@tailwindcss/postcss": "^4.3.5",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@typescript/native-preview": "^7.0.0-dev.20260707.2",
		"autoprefixer": "^10.6.2",
		"baseline-browser-mapping": "^2.11.35",
		"esbuild": "^0.28.2",
		"groq-js": "^2.0.1",
		"postcss": "^8.5.32",
		"tailwindcss": "^4.3.5",
		"typescript": "7.0.2"
	}
}
